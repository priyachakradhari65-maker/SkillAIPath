  as (
    -- dbt Staging Model: Sales Transactions
-- Cleanses and standardizes bronze sales data
-- Single ownership: dbt owns all transformations from bronze onwards



SELECT
  OrderID,
  CustomerName,
  ProductName,
  ProductCategory,
  WareHouseName,
  RetailerName,
  RetailerCity,
