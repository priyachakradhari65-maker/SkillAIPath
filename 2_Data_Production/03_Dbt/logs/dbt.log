[0m19:03:54.397373 [debug] [Thread-8 (]: On model.sap_dw.int_customer_metrics: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "3391a7aa-2111-4b9d-9263-729d0e6e5310", "node_id": "model.sap_dw.int_customer_metrics"} */

  
    
        create or replace table `sap_dev`.`silver`.`int_customer_metrics`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- dbt Intermediate Model: Customer Purchase Metrics
-- Aggregates customer behavior for segmentation and analytics
-- Materialized as table for performance (frequently queried by marts)



WITH customer_orders AS (
  SELECT
    CustomerName,
    COUNT(DISTINCT OrderID) AS order_count,
    SUM(FinalPrice) AS total_spent,
    AVG(FinalPrice) AS avg_order_value,
    MIN(OrderDate) AS first_order_date,
    MAX(OrderDate) AS last_order_date,
    DATEDIFF(CURRENT_DATE(), MAX(OrderDate)) AS days_since_last_order,
    SUM(ProductQuantity) AS total_quantity_purchased
  FROM `sap_dev`.`staging`.`vw_sales`
  GROUP BY CustomerName
)

SELECT
  *,
  CASE 
    WHEN order_count >= 10 THEN 'VIP'
    WHEN order_count >= 5 THEN 'Regular'
    ELSE 'New'
  END AS customer_segment,
  CASE
    WHEN days_since_last_order <= 30 THEN 'Active'
    WHEN days_since_last_order <= 90 THEN 'At Risk'
    ELSE 'Churned'
  END AS activity_status
FROM customer_orders
  
[0m19:03:54.398075 [debug] [Thread-7 (]: Using databricks connection "model.sap_dw.int_product_metrics"
[0m19:03:54.400314 [debug] [Thread-7 (]: On model.sap_dw.int_product_metrics: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "3391a7aa-2111-4b9d-9263-729d0e6e5310", "node_id": "model.sap_dw.int_product_metrics"} */

  
    
        create or replace table `sap_dev`.`silver`.`int_product_metrics`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- dbt Intermediate Model: Product Performance Metrics
-- Aggregates product sales and inventory metrics



WITH product_sales AS (
  SELECT
    ProductName,
    COUNT(DISTINCT OrderID) AS total_orders,
    SUM(ProductQuantity) AS total_quantity_sold,
    SUM(FinalPrice) AS total_revenue,
    AVG(SellingPrice) AS avg_selling_price,
    AVG(CostPrice) AS avg_cost_price,
    AVG(SellingPrice - CostPrice) AS avg_margin,
    MIN(OrderDate) AS first_sale_date,
    MAX(OrderDate) AS last_sale_date
  FROM `sap_dev`.`staging`.`vw_sales`
  GROUP BY ProductName
),

product_inventory AS (
  SELECT
    ProductName,
    AVG(CurrentStock) AS avg_stock_level,
    MAX(ReorderLevel) AS reorder_threshold
  FROM `sap_dev`.`staging`.`vw_stock`
  GROUP BY ProductName
)

SELECT
  s.ProductName,
  s.total_orders,
  s.total_quantity_sold,
  ROUND(s.total_revenue, 2) AS total_revenue,
  ROUND(s.avg_selling_price, 2) AS avg_selling_price,
  ROUND(s.avg_cost_price, 2) AS avg_cost_price,
  ROUND(s.avg_margin, 2) AS avg_margin,
  s.first_sale_date,
  s.last_sale_date,
  ROUND(COALESCE(i.avg_stock_level, 0), 0) AS avg_stock_level,
  i.reorder_threshold
FROM product_sales s
LEFT JOIN product_inventory i ON s.ProductName = i.ProductName
  
