      -- dbt Intermediate Model: Payment Mode Dimension
-- Creates payment mode dimension from sales transactions



WITH unique_payment_modes AS (
  SELECT DISTINCT
    PaymentMode
  FROM `sap_dev`.`staging`.`vw_sales`
  WHERE PaymentMode IS NOT NULL
)

