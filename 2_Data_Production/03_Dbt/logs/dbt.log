[0m13:06:45.256165 [debug] [Thread-10 ]: On model.sap_dw.mart_inventory_health: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "81dde138-608a-468b-83d7-dd3e9b2d77df", "node_id": "model.sap_dw.mart_inventory_health"} */

  
    
        create or replace table `sap_dev`.`gold`.`mart_inventory_health`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- dbt Mart Model: Inventory Health
-- Real-time inventory metrics with turnover ratio and stock aging
-- Uses dbt intermediate models (single ownership: dbt owns silver layer)



WITH current_inventory AS (
  SELECT
    fi.ProductSK,
    fi.WarehouseSK,
    fi.StockQuantity,
    fi.StockValue,
    fi.StockStatus,
    fi.DateID,
    d.Date AS StockDate
  FROM `sap_dev`.`silver`.`fact_inventory` fi
  INNER JOIN `sap_dev`.`silver`.`dim_date` d ON fi.DateID = d.DateID
),

sales_velocity AS (
  SELECT
    fs.ProductSK,
    COUNT(DISTINCT fs.OrderID) AS OrderCount,
    SUM(fs.ProductQuantity) AS TotalSold,
    AVG(fs.ProductQuantity) AS AvgQuantityPerOrder
  FROM `sap_dev`.`silver`.`fact_sales` fs
  INNER JOIN `sap_dev`.`silver`.`dim_date` d ON fs.OrderDateID = d.DateID
  WHERE d.Date >= DATE_SUB(CURRENT_DATE(), 90)  -- Last 90 days
  GROUP BY fs.ProductSK
),

latest_inventory AS (
  SELECT
    ProductSK,
    WarehouseSK,
    StockQuantity,
    StockValue,
    StockStatus,
    StockDate,
    ROW_NUMBER() OVER (PARTITION BY ProductSK, WarehouseSK ORDER BY StockDate DESC) AS rn
  FROM current_inventory
)

SELECT
  li.ProductSK,
  p.ProductName,
  li.WarehouseSK,
  w.WareHouseName AS WarehouseName,
  li.StockQuantity AS CurrentStock,
  li.StockValue AS CurrentStockValue,
  li.StockStatus,
  DATEDIFF(CURRENT_DATE(), li.StockDate) AS DaysInStock,
  COALESCE(sv.TotalSold, 0) AS QuantitySoldLast90Days,
  COALESCE(sv.OrderCount, 0) AS OrderCountLast90Days,
  CASE
    WHEN DATEDIFF(CURRENT_DATE(), li.StockDate) > 0 
    THEN ROUND(COALESCE(sv.TotalSold, 0) * 1.0 / DATEDIFF(CURRENT_DATE(), li.StockDate), 2)
    ELSE 0
  END AS TurnoverRatio,
  CASE
    WHEN li.StockStatus = 'Low Stock' THEN 'Understock'
    WHEN DATEDIFF(CURRENT_DATE(), li.StockDate) > 60 THEN 'Overstock'
    ELSE 'Healthy'
  END AS HealthStatus
FROM latest_inventory li
INNER JOIN `sap_dev`.`silver`.`dim_product` p ON li.ProductSK = p.ProductSK
INNER JOIN `sap_dev`.`silver`.`dim_warehouse` w ON li.WarehouseSK = w.WarehouseSK
LEFT JOIN sales_velocity sv ON li.ProductSK = sv.ProductSK
WHERE li.rn = 1  -- Only latest inventory snapshot per product/warehouse
  
