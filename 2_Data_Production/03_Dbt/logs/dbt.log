[0m21:15:10.938590 [debug] [Thread-4 (]: On model.sap_dw.int_sales_enriched: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "542b6102-549e-452a-8c61-168b0b57fe1c", "node_id": "model.sap_dw.int_sales_enriched"} */

  
    
        create or replace table `sap_dev`.`silver`.`int_sales_enriched`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- dbt Intermediate Model: Sales with Customer and Product Context
-- Enriches sales transactions with customer and product metrics
-- Supports incremental loading with watermark-based filtering



WITH sales_base AS (
  SELECT
    OrderID,
    CustomerName,
    ProductName,
    WareHouseName,
    RetailerName,
    OrderDate,
    ProductQuantity,
    SellingPrice,
    CostPrice,
    FinalPrice,
    TotalAmount,
    LoadedAt
  FROM `sap_dev`.`staging`.`vw_sales`
  
),

customer_context AS (
  SELECT
    CustomerName,
    customer_segment,
    activity_status,
    total_spent AS customer_lifetime_value
  FROM `sap_dev`.`silver`.`int_customer_metrics`
),

product_context AS (
  SELECT
    ProductName,
    avg_margin AS product_avg_margin,
    total_orders AS product_popularity,
    avg_stock_level
  FROM `sap_dev`.`silver`.`int_product_metrics`
)

SELECT
  s.OrderID,
  s.CustomerName,
  c.customer_segment,
  c.activity_status,
  c.customer_lifetime_value,
  s.ProductName,
  p.product_avg_margin,
  p.product_popularity,
  p.avg_stock_level,
  s.WareHouseName,
  s.RetailerName,
  s.OrderDate,
  s.ProductQuantity,
  s.SellingPrice,
  s.CostPrice,
  s.FinalPrice,
  s.TotalAmount,
  ROUND(s.SellingPrice - s.CostPrice, 2) AS transaction_margin,
  ROUND((s.SellingPrice - s.CostPrice) / NULLIF(s.CostPrice, 0) * 100, 2) AS margin_pct,
  s.LoadedAt
FROM sales_base s
LEFT JOIN customer_context c ON s.CustomerName = c.CustomerName
LEFT JOIN product_context p ON s.ProductName = p.ProductName
  
