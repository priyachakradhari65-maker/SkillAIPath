[0m21:14:58.914099 [debug] [Thread-4 (]: On model.sap_dw.dim_date: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "542b6102-549e-452a-8c61-168b0b57fe1c", "node_id": "model.sap_dw.dim_date"} */

  
    
