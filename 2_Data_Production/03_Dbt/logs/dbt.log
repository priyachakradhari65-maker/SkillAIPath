      -- dbt Intermediate Model: Wholesaler Dimension
-- Creates wholesaler dimension from purchase transactions



WITH unique_wholesalers AS (
  SELECT DISTINCT
    WholeSalerName
  FROM `sap_dev`.`staging`.`vw_purchases`
  WHERE WholeSalerName IS NOT NULL
)

