[0m13:08:14.280132 [debug] [Thread-4 (]: On model.sap_dw.dim_date: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "8f5a2ec7-9ca2-471a-b779-4f6bbda769e4", "node_id": "model.sap_dw.dim_date"} */

  
    
