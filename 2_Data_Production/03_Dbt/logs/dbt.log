[0m19:03:50.452312 [debug] [Thread-8 (]: On model.sap_dw.mart_product_performance: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "19e5e031-c509-4e51-8faf-c8c84187af25", "node_id": "model.sap_dw.mart_product_performance"} */

  
    
        create or replace table `sap_dev`.`gold`.`mart_product_performance`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- dbt Mart Model: Product Performance
-- Aggregates product sales, inventory turnover, and profitability
-- Uses dbt intermediate models (single ownership: dbt owns silver layer)



WITH product_sales AS (
  SELECT
    p.ProductSK,
    MAX(fs.ProductCategorySK) AS ProductCategorySK,
    COUNT(DISTINCT fs.OrderID, fs.BatchDate) AS TotalOrders, -- Phase P1: OrderID restarts daily — grain is (OrderID, BatchDate)
    SUM(fs.ProductQuantity) AS TotalQuantitySold,
    SUM(fs.finalprice) AS TotalRevenue,
    AVG(fs.finalprice) AS AvgSaleValue
  FROM `sap_dev`.`silver`.`fact_sales` fs
  INNER JOIN `sap_dev`.`silver`.`dim_product` p ON fs.ProductSK = p.ProductSK
  GROUP BY p.ProductSK
),

product_inventory AS (
  SELECT
    fi.ProductSK,
    AVG(fi.StockQuantity) AS AvgStockLevel
  FROM `sap_dev`.`silver`.`fact_inventory` fi
  GROUP BY fi.ProductSK
)

SELECT
  p.ProductSK,
  p.ProductID,
  p.ProductName,
  pc.ProductCategory,
  ps.TotalOrders,
  ps.TotalQuantitySold,
  ROUND(ps.TotalRevenue, 2) AS TotalRevenue,
  ROUND(ps.AvgSaleValue, 2) AS AvgSaleValue,
  ROUND(pi.AvgStockLevel, 0) AS AvgStockLevel,
  CASE
    WHEN ps.TotalOrders > 100 THEN 'Best Seller'
    WHEN ps.TotalOrders BETWEEN 50 AND 100 THEN 'Popular'
    WHEN ps.TotalOrders BETWEEN 10 AND 49 THEN 'Moderate'
    ELSE 'Slow Mover'
  END AS PerformanceCategory
FROM `sap_dev`.`silver`.`dim_product` p
LEFT JOIN product_sales ps ON p.ProductSK = ps.ProductSK
LEFT JOIN product_inventory pi ON p.ProductSK = pi.ProductSK
LEFT JOIN `sap_dev`.`silver`.`dim_product_category` pc ON ps.ProductCategorySK = pc.ProductCategorySK
  
[0m19:03:50.469745 [debug] [Thread-7 (]: Using databricks connection "model.sap_dw.mart_customer_360"
[0m19:03:50.471470 [debug] [Thread-7 (]: On model.sap_dw.mart_customer_360: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "19e5e031-c509-4e51-8faf-c8c84187af25", "node_id": "model.sap_dw.mart_customer_360"} */

  
    
        create or replace table `sap_dev`.`gold`.`mart_customer_360`
      
      
    using delta
  
      
      
      
      
      
      
      
      
      as
      -- dbt Mart Model: Customer 360
-- Combines customer demographics, purchase behavior, and lifetime value
-- Uses dbt intermediate models (single ownership: dbt owns silver layer)



WITH customer_purchases AS (
  SELECT
    c.CustomerSK,
    COUNT(DISTINCT fs.OrderID, fs.BatchDate) AS TotalPurchases, -- Phase P1: OrderID restarts daily — grain is (OrderID, BatchDate)
    SUM(fs.finalprice) AS TotalSpend,
    AVG(fs.finalprice) AS AvgOrderValue,
    MIN(d.Date) AS FirstPurchaseDate,
    MAX(d.Date) AS LastPurchaseDate,
    DATEDIFF(CURRENT_DATE(), MAX(d.Date)) AS DaysSinceLastPurchase
  FROM `sap_dev`.`silver`.`fact_sales` fs
  INNER JOIN `sap_dev`.`silver`.`dim_customer` c ON fs.CustomerSK = c.CustomerSK
  INNER JOIN `sap_dev`.`silver`.`dim_date` d ON fs.OrderDateID = d.DateID
  GROUP BY c.CustomerSK
)

SELECT
  c.CustomerSK AS CustomerKey,
  c.CustomerID,
  c.CustomerName,
  c.CustomerMail AS Email,
  c.CustomerContact AS Phone,
  NULL AS City,
  NULL AS State,
  COALESCE(cp.TotalPurchases, 0) AS TotalPurchases,
  ROUND(COALESCE(cp.TotalSpend, 0), 2) AS TotalSpend,
  ROUND(COALESCE(cp.AvgOrderValue, 0), 2) AS AvgOrderValue,
  cp.FirstPurchaseDate,
  cp.LastPurchaseDate,
  cp.DaysSinceLastPurchase,
  CASE
    WHEN COALESCE(cp.TotalPurchases, 0) = 0 THEN 'New Customer'
    WHEN cp.TotalPurchases = 1 THEN 'New Customer'
    WHEN cp.TotalPurchases BETWEEN 2 AND 5 THEN 'Returning Customer'
    WHEN cp.TotalPurchases > 5 THEN 'VIP Customer'
  END AS CustomerSegment,
  CASE
    WHEN cp.DaysSinceLastPurchase IS NULL THEN 'Inactive'
    WHEN cp.DaysSinceLastPurchase <= 30 THEN 'Active'
    WHEN cp.DaysSinceLastPurchase <= 90 THEN 'At Risk'
    ELSE 'Churned'
  END AS ActivityStatus
FROM `sap_dev`.`silver`.`dim_customer` c
LEFT JOIN customer_purchases cp ON c.CustomerSK = cp.CustomerSK
WHERE c.IsCurrent = 1
  
