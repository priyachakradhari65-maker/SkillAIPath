  create or replace view `sap_dev`.`staging`.`vw_products`
  
  
  as (
    -- dbt Staging Model: Product Master
-- Extracts distinct products from bronze sales
-- Pure staging: no aggregations, no business logic



SELECT DISTINCT
  md5(cast(concat(coalesce(cast(ProductName as string), '')) as string)) AS ProductKey,
  ProductName,
  CURRENT_TIMESTAMP() AS LoadedAt
FROM `sap_dev`.`bronze`.`stg_sales`
WHERE ProductName IS NOT NULL
  )


    
[0m13:06:27.886216 [debug] [Thread-11 ]: On model.sap_dw.stg_sales: /* {"app": "dbt", "dbt_version": "1.12.6", "dbt_databricks_version": "1.13.0", "databricks_sql_connector_version": "4.4.0", "profile_name": "sap_dw", "target_name": "dev", "invocation_id": "efad2f10-e4cd-4ef5-9d6d-46baafe041e7", "node_id": "model.sap_dw.stg_sales"} */

      
  
  
  
  create or replace view `sap_dev`.`staging`.`vw_sales`
  
  
  as (
    -- dbt Staging Model: Sales Transactions
-- Cleanses and standardizes bronze sales data
-- Single ownership: dbt owns all transformations from bronze onwards



SELECT
  OrderID,
  CustomerName,
  ProductName,
  ProductCategory,
  WareHouseName,
  RetailerName,
  RetailerCity,
  RetailerContact,
  RetailerMail,
  AgentName,
  AgentCity,
  AgentContact,
  AgentMail,
  PaymentMode,
  CAST(OrderDate AS DATE) AS OrderDate,
  CAST(MFDDate AS DATE) AS MFDDate,
  CAST(EXPDate AS DATE) AS EXPDate,
  CAST(DeliveryDate AS DATE) AS DeliveryDate,
  ProductQuantity,
  ROUND(CostPrice, 2) AS CostPrice,
  ROUND(sellingPrice, 2) AS SellingPrice,
  ROUND(discount, 2) AS Discount,
  ROUND(finalprice, 2) AS FinalPrice,
  ROUND(CGST, 2) AS CGST,
  ROUND(SGST, 2) AS SGST,
  ROUND(finalprice + CGST + SGST, 2) AS TotalAmount,
  CAST(BatchDate AS DATE) AS BatchDate,
  CAST(LoadedAt AS TIMESTAMP) AS LoadedAt
FROM `sap_dev`.`bronze`.`stg_sales`
WHERE finalprice > 0  -- Data quality: Remove invalid transactions
  AND ProductQuantity > 0
  )


    
